# 이 파일을 .env 로 복사해서 값 채우면 자동 로드됨 (telegram_utils/main 이 load_dotenv).
# ─────────────────────────────────────────────
# 텔레그램 알림 (연동됨 — 토큰만 넣으면 켜짐)
#   봇토큰: @BotFather 로 봇 생성 → 토큰. chat_id: @userinfobot 또는 봇에 메시지 후 getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS_ENABLED=1
# ─────────────────────────────────────────────
# API 키 — 기본은 컨트롤패널(control_panel.py → live_settings.json) 사용. 여기 넣으면 폴백/대체.
#   소액 테스트(demo):
# BYBIT_DEMO_API_KEY=
# BYBIT_DEMO_API_SECRET=
#   실계좌(live):
# BYBIT_LIVE_API_KEY=
# BYBIT_LIVE_API_SECRET=
