# Stage 4J: 추가 차단 + booster matrix
# =========================================================
def is_stage4j_blocked(tier: str, side: str, symbol: str,
                       run_potential: Optional[int]) -> Optional[str]:
    """outlier 1건 의존 그룹 차단 (BTC R=167, AVAX R=33)."""
    rp = int(run_potential) if run_potential is not None else -1
    # GEM LONG RP1 — BTC R=167 한 건 의존
    if tier == "SWEEP_GEM" and side == "long" and rp == 1:
        return "GEM_LONG_RP1_outlier_dep"
    # ROOM_ONLY AVAX — AVAX R=33 한 건 의존
    if tier == "SWEEP_ROOM_ONLY" and symbol == "AVAXUSDT":
        return "ROOM_ONLY_AVAX_outlier_dep"
    return None


def get_stage4j_extra_mult(tier: str, side: str, symbol: str,
                           run_potential: Optional[int]) -> Tuple[float, str]:
    """
    Stage 4J extra mult layer (1.5× / 1.2× / 1.0× booster).
    차단 통과한 거래에 한해 호출.
    """
    rp = int(run_potential) if run_potential is not None else -1
    
    # ── 1.5× booster ──
    if tier == "SWEEP_ROOM_FVG" and symbol == "DOGEUSDT":
        return (1.5, "BOOST15_FVG_DOGE")
    if tier == "SWEEP_GEM" and side == "long" and rp == 2:
        return (1.5, "BOOST15_GEM_LONG_RP2")
    
    # ── 1.2× booster ──
    if tier == "SWEEP_GEM" and side == "long" and rp == 0:
        return (1.2, "BOOST12_GEM_LONG_RP0")
    if tier == "SWEEP_ROOM_ONLY" and symbol == "ADAUSDT":
        return (1.2, "BOOST12_ROOM_ONLY_ADA")
    if tier == "SWEEP_ROOM_ONLY" and side == "long" and rp == 1 and symbol != "ADAUSDT":
        return (1.2, "BOOST12_ROOM_ONLY_LONG_RP1")
    if tier == "SWEEP_ROOM_FVG" and side == "long" and rp == 2 and symbol != "DOGEUSDT":
        return (1.2, "BOOST12_FVG_LONG_RP2")
    
    return (1.0, "DEFAULT")


# =========================================================
# Stage 4K: Sentiment Momentum lookback (실전 버전)
# 백테스트는 executed_trades list, 실전은 trade_journal.csv 에서 자동 로드
# =========================================================
def _load_recent_journal_for_sentiment(now_utc: datetime,
                                        days: int = 14) -> List[Dict[str, Any]]:
    """trade_journal.csv 에서 직전 days 일 거래 추출."""
    try:
        from log_store import load_trade_journal_rows
        rows = load_trade_journal_rows(limit=500)
    except Exception:
        return []
    
    cutoff = now_utc - timedelta(days=days)
    result = []
    for r in rows:
        opened_at = str(r.get("opened_at", "") or "")
        if not opened_at:
            continue
        try:
            ot = datetime.fromisoformat(opened_at.replace("Z", "+00:00"))
            if ot.tzinfo is None:
                ot = ot.replace(tzinfo=timezone.utc)
        except Exception:
            continue
        if ot < cutoff or ot >= now_utc:
            continue
        side = str(r.get("side", "") or "").lower()
        rp_raw = r.get("run_potential")
        if side not in ("long", "short") or rp_raw is None or rp_raw == "":
            continue
        try:
            rp_int = int(float(rp_raw))
        except Exception:
            continue
        result.append({"entry_time": ot, "side": side, "run_potential": rp_int})
    return result


def compute_sentiment_lookback(target_time,
                                executed_trades_so_far: Optional[List[Dict[str, Any]]] = None,
                                days: int = 7) -> Tuple[Optional[float], int]:
    """
    target_time 직전 days 일의 모든 체결 거래 → LONG/SHORT RP 평균 격차.
    
    실전 모드: executed_trades_so_far=None 이면 trade_journal 에서 자동 로드
    백테스트 모드: executed_trades_so_far list 직접 전달
    
    Returns: (sentiment, n_window) — 측정 불가시 (None, n)
    """
    # target_time 정규화
    if isinstance(target_time, str):
        try:
            target_time = datetime.fromisoformat(target_time.replace("Z", "+00:00"))
        except Exception:
            return None, 0
    if hasattr(target_time, "to_pydatetime"):
        target_time = target_time.to_pydatetime()
    if isinstance(target_time, datetime) and target_time.tzinfo is None:
        target_time = target_time.replace(tzinfo=timezone.utc)
    
    if executed_trades_so_far is None:
        # 실전: trade_journal 에서 로드 (직전 14일치 cushion)
        executed_trades_so_far = _load_recent_journal_for_sentiment(
            target_time, days=days + SENTIMENT_PREV_OFFSET
        )
    
    if not executed_trades_so_far:
        return None, 0
    
    cutoff = target_time - timedelta(days=days)
    long_rps: List[int] = []
    short_rps: List[int] = []
    for tr in executed_trades_so_far:
        et = tr.get("entry_time")
        if et is None:
            continue
        # entry_time 정규화
        if isinstance(et, str):
            try:
                et = datetime.fromisoformat(et.replace("Z", "+00:00"))
            except Exception:
                continue
        if hasattr(et, "to_pydatetime"):
            et = et.to_pydatetime()
        if isinstance(et, datetime) and et.tzinfo is None:
            et = et.replace(tzinfo=timezone.utc)
        
        if et >= target_time:
            continue
        if et < cutoff:
            continue
        rp = tr.get("run_potential")
        side = tr.get("side")
        if rp is None or side not in ("long", "short"):
            continue
        try:
            rp_int = int(rp)
        except Exception:
            continue
        if side == "long":
            long_rps.append(rp_int)
        else:
            short_rps.append(rp_int)
    
    n_total = len(long_rps) + len(short_rps)
    if len(long_rps) < SENTIMENT_MIN_SAMPLES or len(short_rps) < SENTIMENT_MIN_SAMPLES:
        return None, n_total
    return (float(np.mean(long_rps)) - float(np.mean(short_rps))), n_total


def get_stage4k_sentiment_mult(target_time,
                                side: str,
                                executed_trades_so_far: Optional[List[Dict[str, Any]]] = None,
                                scenario: Optional[str] = None) -> Tuple[float, str]:
    """
    Stage 4K Sentiment Momentum 매트릭스 적용 (4 booster + 3 cut).
    
    cell:
      BOOST_TopReversal     : sent>+0.3, chg>+0.2, SHORT  → BOOST mult
      BOOST_BottomReversal  : sent<-0.3, chg<-0.2, LONG   → BOOST mult
      BOOST_TrendStart_L    : |sent|<=0.3, chg>+0.2, LONG  → BOOST mult
      BOOST_TrendStart_S    : |sent|<=0.3, chg>+0.2, SHORT → BOOST mult
      CUT_NeutStable_S      : |sent|<=0.3, |chg|<=0.2, SHORT → CUT mult
      CUT_NeutFalling_S     : |sent|<=0.3, chg<-0.2, SHORT  → CUT mult
      CUT_ShortStable_L     : sent<-0.3, |chg|<=0.2, LONG   → CUT mult
    
    측정 불가 시 (1.0, "no_data"). cell 매트릭스 외 (1.0, "default").
    """
    if scenario is None:
        scenario = SCENARIO
    cfg = SENTIMENT_BOOSTER_BY_SCENARIO.get(scenario)
    if cfg is None:
        return (1.0, "no_scenario")
    
    # target_time 정규화
    if isinstance(target_time, str):
        try:
            target_time = datetime.fromisoformat(target_time.replace("Z", "+00:00"))
        except Exception:
            return (1.0, "no_data")
    if hasattr(target_time, "to_pydatetime"):
        target_time = target_time.to_pydatetime()
    if isinstance(target_time, datetime) and target_time.tzinfo is None:
        target_time = target_time.replace(tzinfo=timezone.utc)
    
    s_now, _  = compute_sentiment_lookback(target_time, executed_trades_so_far,
                                            days=SENTIMENT_LOOKBACK_DAYS)
    s_prev, _ = compute_sentiment_lookback(
        target_time - timedelta(days=SENTIMENT_PREV_OFFSET),
        executed_trades_so_far, days=SENTIMENT_LOOKBACK_DAYS
    )
    if s_now is None or s_prev is None:
        return (1.0, "no_data")
    
    chg = s_now - s_prev
    BOOST = float(cfg["BOOST"])
    CUT   = float(cfg["CUT"])
    
    # ── 강력 4 BOOSTER ──
    if s_now > 0.3 and chg > 0.2 and side == "short":
        return (BOOST, "BOOST_TopReversal")        # PF 15.51
    if s_now < -0.3 and chg < -0.2 and side == "long":
        return (BOOST, "BOOST_BottomReversal")     # PF 7.31
    if abs(s_now) <= 0.3 and chg > 0.2 and side == "long":
        return (BOOST, "BOOST_TrendStart_L")       # PF 8.77
    if abs(s_now) <= 0.3 and chg > 0.2 and side == "short":
        return (BOOST, "BOOST_TrendStart_S")       # PF 5.22
    
    # ── 약점 3 CUT ──
    if abs(s_now) <= 0.3 and abs(chg) <= 0.2 and side == "short":
        return (CUT, "CUT_NeutStable_S")           # PF 0.35
    if abs(s_now) <= 0.3 and chg < -0.2 and side == "short":
        return (CUT, "CUT_NeutFalling_S")          # PF 0.74
    if s_now < -0.3 and abs(chg) <= 0.2 and side == "long":
        return (CUT, "CUT_ShortStable_L")          # PF 0.47
    
    return (1.0, "default")


# =========================================================
# atomic 12 컨디션 계산 (백테스트 compute_trade_tags 그대로)
# =========================================================
def compute_trade_tags(df_struct: pd.DataFrame, entry_idx: int, zone_created_idx: int,
                       zone_low: float, zone_high: float, side: str,
                       pre_total: int, sweep_count: int, score: float, wick_ratio_5: float,
                       structure_reasons: str, atr_val: float) -> Dict[str, bool]:
    """
    12개 atomic 태그 계산 (Stage 4H tier 분류 입력).
    """
    tags: Dict[str, bool] = {}

    # ─── Entry Signal (2개) ───
    # SWEEP
    start = max(0, entry_idx - SWEEP_LOOKBACK_BARS)
    end = entry_idx
    try:
        if side == "long":
            pivot_sw = df_struct.loc[start:end, "pivot_sweep_low"].any() if "pivot_sweep_low" in df_struct.columns else False
            recent_sw = df_struct.loc[start:end, "recent_sweep_low"].any() if "recent_sweep_low" in df_struct.columns else False
        else:
            pivot_sw = df_struct.loc[start:end, "pivot_sweep_high"].any() if "pivot_sweep_high" in df_struct.columns else False
            recent_sw = df_struct.loc[start:end, "recent_sweep_high"].any() if "recent_sweep_high" in df_struct.columns else False
        tags["a_sweep"] = bool(pivot_sw or recent_sw)
    except Exception:
        tags["a_sweep"] = False

    # VOLUME spike
    try:
        if "volume" in df_struct.columns:
            vstart = max(0, zone_created_idx - VOLUME_AVG_WINDOW)
            vend = zone_created_idx
            if vend <= vstart:
                tags["a_volume"] = False
            else:
                avg_vol = df_struct.loc[vstart:vend - 1, "volume"].mean()
                zone_vol = df_struct.loc[zone_created_idx, "volume"]
                if pd.isna(avg_vol) or avg_vol <= 0:
                    tags["a_volume"] = False
                else:
                    tags["a_volume"] = bool((zone_vol / avg_vol) >= VOLUME_SPIKE_MULT)
        else:
            tags["a_volume"] = False
    except Exception:
        tags["a_volume"] = False

    # ─── Tier 구성 5개 ───
    pt = int(pre_total) if pre_total is not None and not pd.isna(pre_total) else 0
    sc = int(sweep_count) if sweep_count is not None and not pd.isna(sweep_count) else 0
    sv = float(score) if score is not None and not pd.isna(score) else 0.0
    wv = wick_ratio_5

    tags["a_pre_total_ge4"]   = (pt >= 4)
    tags["a_sweep_count_2_4"] = (2 <= sc <= 4)
    tags["a_score_ge13"]      = (sv >= 13.0)
    tags["a_wick_le_q1"]      = (wv is not None) and (not pd.isna(wv)) and (wv <= WICK_RATIO_5_Q1_THRESHOLD)
    tags["a_pre_total_ge1"]   = (pt >= 1)

    # ─── RP 구성 5개 ───
    reasons = str(structure_reasons) if structure_reasons is not None else ""
    reasons_set = set(r.strip() for r in reasons.split(",") if r.strip())

    # trend_align
    try:
        h4_trend = df_struct.loc[entry_idx, "trend"] if "trend" in df_struct.columns else "neutral"
    except Exception:
        h4_trend = "neutral"
    tags["a_trend_align"] = (side == "long" and h4_trend == "up") or \
                             (side == "short" and h4_trend == "down")

    tags["a_mss"]     = ("bull_mss" in reasons_set) or ("bear_mss" in reasons_set)
    tags["a_fvg"]     = ("valid_bull_fvg" in reasons_set) or ("valid_bear_fvg" in reasons_set)
    tags["a_overlap"] = ("bull_ob_fvg_overlap" in reasons_set) or \
                         ("bear_ob_fvg_overlap" in reasons_set)

    # a_room: get_run_potential 결과 (room) 직접 접근 어렵 → atr 기반 근사
    a_room = False
    try:
        if pd.notna(atr_val) and atr_val > 0:
            if side == "long":
                entry_proxy = zone_low + (zone_high - zone_low) * 0.40
                room_target = df_struct.loc[entry_idx, "pd_high"] if "pd_high" in df_struct.columns else np.nan
                if pd.notna(room_target):
                    risk_est = max(atr_val * SL_BUFFER_MULT, 1e-9)
                    room_est = max(float(room_target) - entry_proxy, 0.0)
                    a_room = (room_est >= risk_est * 2.8)
            else:
                entry_proxy = zone_low + (zone_high - zone_low) * 0.60
                room_target = df_struct.loc[entry_idx, "pd_low"] if "pd_low" in df_struct.columns else np.nan
                if pd.notna(room_target):
                    risk_est = max(atr_val * SL_BUFFER_MULT, 1e-9)
                    room_est = max(entry_proxy - float(room_target), 0.0)
                    a_room = (room_est >= risk_est * 2.8)
    except Exception:
        a_room = False
    tags["a_room"] = bool(a_room)

    return tags


