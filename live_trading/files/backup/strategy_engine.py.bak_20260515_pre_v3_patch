def get_h1_window(df_h1_local: pd.DataFrame, h4_timestamp: pd.Timestamp, lookback_hours: int = 12) -> pd.DataFrame:
    start_ts = h4_timestamp - pd.Timedelta(hours=lookback_hours)
    end_ts = h4_timestamp
    return df_h1_local[(df_h1_local["timestamp"] > start_ts) & (df_h1_local["timestamp"] <= end_ts)].copy()


def refine_entry_with_h1_fvg(
    df_h1_local: pd.DataFrame,
    h4_timestamp: pd.Timestamp,
    side: str,
    zone_low: float,
    zone_high: float,
    base_entry: float,
    lookback_hours: int = 12,
    max_improve_frac: float = 0.25,
) -> Tuple[float, bool, float, str]:
    zone_size = zone_high - zone_low
    if zone_size <= 0:
        return base_entry, False, np.nan, ""

    max_improve = zone_size * max_improve_frac
    win = get_h1_window(df_h1_local, h4_timestamp, lookback_hours=lookback_hours)

    if len(win) == 0:
        return base_entry, False, np.nan, ""

    if side == "long":
        candidates = []
        for _, r in win.iterrows():
            if pd.notna(r["bull_fvg_low"]) and pd.notna(r["bull_fvg_high"]):
                mid = (float(r["bull_fvg_low"]) + float(r["bull_fvg_high"])) / 2.0
                if zone_low <= mid <= zone_high and mid < base_entry:
                    candidates.append({"ts": r["timestamp"], "mid": mid, "tag": "h1_bull_fvg_mid"})

        if not candidates:
            return base_entry, False, np.nan, ""

        candidates = sorted(candidates, key=lambda x: abs(base_entry - x["mid"]))
        candidate = candidates[0]["mid"]
        candidate = max(candidate, base_entry - max_improve)
        candidate = max(candidate, zone_low)
        candidate = min(candidate, base_entry)

        improved = candidate < base_entry - 1e-12
        return candidate, improved, candidate, candidates[0]["tag"]

    candidates = []
    for _, r in win.iterrows():
        if pd.notna(r["bear_fvg_low"]) and pd.notna(r["bear_fvg_high"]):
            mid = (float(r["bear_fvg_low"]) + float(r["bear_fvg_high"])) / 2.0
            if zone_low <= mid <= zone_high and mid > base_entry:
                candidates.append({"ts": r["timestamp"], "mid": mid, "tag": "h1_bear_fvg_mid"})

    if not candidates:
        return base_entry, False, np.nan, ""

    candidates = sorted(candidates, key=lambda x: abs(base_entry - x["mid"]))
    candidate = candidates[0]["mid"]
    candidate = min(candidate, base_entry + max_improve)
    candidate = min(candidate, zone_high)
    candidate = max(candidate, base_entry)

    improved = candidate > base_entry + 1e-12
    return candidate, improved, candidate, candidates[0]["tag"]


def get_latest_balance_usdt(wallet_response: Dict[str, Any]) -> float:
    try:
        accounts = wallet_response.get("result", {}).get("list", [])
        for account in accounts:
            coins = account.get("coin", [])
            for coin in coins:
                if coin.get("coin") == "USDT":
                    val = coin.get("walletBalance") or coin.get("equity") or "0"
                    return float(val)
    except Exception:
        return 0.0
    return 0.0


def generate_entry_signal(
    df_h4_raw: pd.DataFrame,
    df_h1_raw: pd.DataFrame,
    balance: float,
    risk_pct: float,
    fee_rate: float,
    max_notional_mult: float,
    current_price: Optional[float] = None,
    last_exit_time_iso: Optional[str] = None,
    last_exit_side: Optional[str] = None,
    risk_multiplier: float = 1.0,
    df_1m_raw: Optional[pd.DataFrame] = None,
    symbol: Optional[str] = None,
) -> Dict[str, Any]:
    if len(df_h4_raw) < 250 or len(df_h1_raw) < 400:
        return {
            "should_enter": False,
            "reason": "not_enough_data",
            "h4_rows": len(df_h4_raw),
            "h1_rows": len(df_h1_raw),
        }

    # ⭐ v1.9_BASELINE: Global Risk Multiplier (패널 runtime 조절)
    # base risk_pct 에 multiplier 곱해서 이후 모든 계산에 반영.
    # 실전 패널에서 0.5 ~ 3.0 범위로 조절 가능.
    try:
        _rm = float(risk_multiplier) if risk_multiplier is not None else 1.0
    except Exception:
        _rm = 1.0
    if _rm <= 0.0:
        _rm = 1.0
    risk_pct = float(risk_pct) * _rm
    # 주의: max_notional_mult 인자는 이제 fallback 용. 실제로는 tier 별로
    # resolve_notional_cap() 결과가 사용됨.

    df_h4 = prepare_h4_dataframe(df_h4_raw.copy())
    df_h1 = prepare_h1_dataframe(df_h1_raw.copy())

    # ⭐ Stage 3 Wave-aware: H4 trend ← H1 CHoCH state
    df_h4 = apply_h1_choch_trend(df_h4, df_h1)
    # 이제 base_trend 가 H1 CHoCH 기반이므로 market_state 도 같은 기반으로 계산됨
    df_h4 = apply_h4_market_state(df_h4, transition_bars=360)

    df_struct, structures, _ = build_structures(df_h4.copy())

    if len(df_struct) < 220:
        return {
            "should_enter": False,
            "reason": "not_enough_processed_h4_data",
        }

    # ⭐ Stage 3 Wave-aware: D1 wave_state (Multi-fractal context)
    try:
        df_d1 = build_d1_trend(df_struct)
    except Exception:
        df_d1 = pd.DataFrame()

    i = len(df_struct) - 2
    row = df_struct.iloc[i]

    # [BACKTEST v1.2] Same-side cooldown 체크
    # 스탑 직후 같은 방향으로 재진입하는 것 금지
    same_side_block = None
    if last_exit_time_iso and last_exit_side:
        try:
            last_exit_dt = datetime.fromisoformat(last_exit_time_iso.replace("Z", "+00:00"))
            if last_exit_dt.tzinfo is None:
                last_exit_dt = last_exit_dt.replace(tzinfo=timezone.utc)
            now_utc = datetime.now(timezone.utc)
            elapsed_hours = (now_utc - last_exit_dt).total_seconds() / 3600.0
            if elapsed_hours < SAME_SIDE_COOLDOWN_HOURS:
                # "Buy"/"Sell" → "long"/"short" 변환
                _side_map = {"Buy": "long", "Sell": "short"}
                blocked_side = _side_map.get(last_exit_side, str(last_exit_side).lower())
                same_side_block = blocked_side
        except Exception:
            pass

    # [BACKTEST v1.2] RELAX_MIN_SCORE 로 후보 필터 (관대)
    # 이후 fresh_bonus 추가해서 eff_score >= MIN_SCORE 인 것만 진입
    active_structures = [
        s for s in structures
        if s["zone_created_idx"] <= i <= s["expire_idx"] and s["score"] >= RELAX_MIN_SCORE
    ]

    # ⭐ Stage 4K: zone 일괄 평가 (atomic 12 + tier + 4I/4J 차단/booster 적용) ⭐
    evaluated_zones = evaluate_zones_at_current_time(
        df_h4=df_struct,
        df_h1=df_h1,
        active_structures=active_structures,
        i=i,
        exclude_recent_h1=EXCLUDE_RECENT_H1_FOR_TIER,
        symbol=symbol,
    )

    # ⭐ v1.9_REALISTIC: 정렬 키 선택 (tier 우선 or score 우선)
    if USE_TIER_PRIORITY_SORT:
        # tier 우선: tier_mult_final 내림차순 > eff_score 내림차순 > zone_created_idx 오름차순
        evaluated_zones.sort(key=lambda z: (
            -float(z["tier_mult_final"]),
            -float(z["eff_score"]),
            int(z["zone_created_idx"]),
        ))
    else:
        # 기존 방식: eff_score 내림차순 > zone_created_idx 오름차순
        evaluated_zones.sort(key=lambda z: (
            -float(z["eff_score"]),
            int(z["zone_created_idx"]),
        ))

    for z in evaluated_zones:
        # tier 가 D 또는 RP skip 이면 즉시 스킵
        if not z["tier_passable"]:
            continue

        # 기존 s 참조를 z 로 사용 (dict 이므로 zone_low 등 접근 동일)
        s = z
        eff_score = z["eff_score"]
        fresh_reasons = z["fresh_reasons"]

        # [BACKTEST v1.2] Same-side cooldown: 방금 스탑 난 방향 skip
        if same_side_block is not None and s["type"] == same_side_block:
            continue

        # 실시간 모드: 현재가가 zone 안에 있는지 체크
        # v2.0 WICK: 1분봉 high/low 로 wick-only touch 도 감지
        if current_price is not None:
            touched_now = (s["zone_low"] <= current_price <= s["zone_high"])
            touched_wick = False
            # current_price 가 zone 밖이면 1분봉 wick touch 확인
            if (not touched_now) and USE_1M_WICK_TOUCH and df_1m_raw is not None and len(df_1m_raw) > 0:
                try:
                    lookback_n = int(WICK_TOUCH_LOOKBACK_BARS)
                    recent_1m = df_1m_raw.tail(lookback_n)
                    recent_high = float(recent_1m["high"].max())
                    recent_low = float(recent_1m["low"].min())
                    wick_touched = (recent_high >= s["zone_low"]) and (recent_low <= s["zone_high"])
                    if wick_touched:
                        # 이탈 거리 체크: 현재가가 zone 에서 너무 멀리 가면 skip
                        zone_size = s["zone_high"] - s["zone_low"]
                        if zone_size > 0:
                            if s["type"] == "long":
                                # LONG zone 이면 current_price > zone_high 일 때 이탈
                                exit_distance = max(0.0, current_price - s["zone_high"])
                            else:
                                # SHORT zone 이면 current_price < zone_low 일 때 이탈
                                exit_distance = max(0.0, s["zone_low"] - current_price)
                            exit_frac = exit_distance / zone_size
                            if exit_frac <= WICK_TOUCH_MAX_EXIT_FRAC:
                                touched_wick = True
                            # else: 너무 늦음, skip
                except Exception:
                    touched_wick = False
            touched = touched_now or touched_wick
        else:
            touched = (row["high"] >= s["zone_low"]) and (row["low"] <= s["zone_high"])
        if not touched:
            continue

        # [BACKTEST v1.2] Volume filter (zone 형성 bar 의 volume spike 확인)
        vol_ok, vol_reason = passes_volume_filter(df_struct, s["zone_created_idx"])
        if not vol_ok:
            continue

        atr_val = df_struct.loc[i, "atr"] if pd.notna(df_struct.loc[i, "atr"]) else 0.0

        # ⭐ v1.9_REALISTIC: evaluate_zones_at_current_time 에서 미리 계산된 값 재사용
        rp = int(z["run_potential"])
        rp_tags = z["run_tags"]
        grade = classify_grade(float(eff_score), rp)
        h4_market_state = df_struct.loc[i, "market_state"]

        if s["type"] == "short":
            if df_struct.loc[i, "trend"] == "up":
                continue

            h1_confirm = has_recent_h1_choch(
                df_h1_local=df_h1,
                h4_timestamp=df_struct.loc[i, "timestamp"],
                side="short",
                lookback_hours=H1_CHOCH_CONFIRM_HOURS,
            )

            base_entry_candidate = s["zone_low"] + (s["zone_high"] - s["zone_low"]) * SHORT_BASE_ENTRY_FRAC

            refined_entry_candidate, improved, refine_px, refine_reason = refine_entry_with_h1_fvg(
                df_h1_local=df_h1,
                h4_timestamp=df_struct.loc[i, "timestamp"],
                side="short",
                zone_low=s["zone_low"],
                zone_high=s["zone_high"],
                base_entry=base_entry_candidate,
                lookback_hours=H1_REFINE_LOOKBACK_HOURS,
                max_improve_frac=H1_REFINE_MAX_IMPROVE_FRAC,
            )

            # [HONEST-FALLBACK] fill_entry_price 결정
            if current_price is not None:
                # 실시간 모드: 현재가 = 체결가 (시장가 주문)
                fill_entry_price = float(current_price)
            else:
                # 백테스트 호환 모드
                fill_entry_price = float(max(s["zone_low"], min(row["open"], s["zone_high"])))
                if row["high"] >= refined_entry_candidate:
                    fill_entry_price = float(refined_entry_candidate)

            raw_sl = s["sweep_ref"] + atr_val * SL_BUFFER_MULT
            sl_candidate = clamp_stop_for_short(fill_entry_price, raw_sl, atr_val)
            if sl_candidate <= fill_entry_price:
                continue

            # ⭐ Stage 4K: evaluate_zones 에서 미리 계산된 값 재사용 ⭐
            pre_sweep = z["tier_pre_sweep"]
            pre_fvg = z["tier_pre_fvg"]
            pre_ob = z["tier_pre_ob"]
            pre_total = z["tier_pre_total"]
            wick_r5 = z["wick_ratio_5"]
            tier_label = z["tier"]
            tier_mult_raw = z["tier_mult_raw"]
            rp_action = z["rp_action"]
            tier_mult = z["tier_mult_final"]
            effective_notional_cap = z["effective_notional_cap"]
            stage4j_mult = z.get("stage4j_mult", 1.0)
            stage4j_label = z.get("stage4j_label", "DEFAULT")
            atoms_dict = z.get("atoms_dict", {})

            # tier 가 passable 이 아니면 위에서 이미 continue 처리됨.
            # 여기서는 tier_mult > 0 이 보장됨.

            # ⭐ Stage 4K: Sentiment Momentum lookback (직전 7일 LS 격차) ⭐
            entry_time_now = df_struct.loc[i, "timestamp"]
            sentiment_mult, sentiment_label = get_stage4k_sentiment_mult(
                target_time=entry_time_now,
                side="short",
            )

            # ⭐⭐⭐ Stage 3 Wave-aware 처방 (옵션 A+B+C + Balance-aware) ⭐⭐⭐
            step3_mult, step3_info = get_step3_risk_multipliers(
                df_struct=df_struct, df_h1=df_h1, df_d1=df_d1,
                i=i, side="short", balance=float(balance),
            )

            # 최종 risk_pct: tier_mult × sentiment × step3 (pd_aware × weak_setup × wave_pattern)
            risk_pct_adjusted = float(risk_pct) * float(tier_mult) * float(sentiment_mult) * float(step3_mult)

            qty_candidate, risk_per_unit, notional_candidate = calc_position_size(
                balance=balance,
                risk_pct=risk_pct_adjusted,
                entry=fill_entry_price,
                sl=sl_candidate,
                fee_rate=fee_rate,
                max_notional_mult=effective_notional_cap,
            )
            if qty_candidate is None:
                continue

            expansion_candidate = get_expansion_state(
                market_state=h4_market_state,
                h1_choch_confirm=h1_confirm,
            )
            plan = get_tp_plan(expansion_candidate)

            return {
                "should_enter": True,
                "timestamp": str(df_struct.loc[i, "timestamp"]),
                "h4_closed_index": int(i),
                "side": "Sell",
                "position_side": "short",
                "entry": float(fill_entry_price),
                "base_entry": float(base_entry_candidate),
                "entry_refined": bool(improved),
                "refined_entry_px": float(refine_px) if pd.notna(refine_px) else None,
                "refine_tag": refine_reason,
                "sl": float(sl_candidate),
                "qty": float(qty_candidate),
                "notional": float(notional_candidate),
                "risk_per_unit": float(risk_per_unit),
                "score": float(eff_score),
                "base_score": float(s["score"]),
                "fresh_reasons": fresh_reasons,
                "grade": grade,
                "run_potential": int(rp),
                "run_tags": rp_tags,
                "tp_plan_name": plan["name"],
                "tp_plan": plan,
                "expansion_state": bool(expansion_candidate),
                "reasons": s["reasons"],
                "zone_low": float(s["zone_low"]),
                "zone_high": float(s["zone_high"]),
                "sweep_ref": float(s["sweep_ref"]),
                "trend": str(df_struct.loc[i, "trend"]),
                "market_state": str(h4_market_state),
                "h1_choch_confirm": bool(h1_confirm),
                "h1_choch_time": str(get_recent_h1_choch_time(df_h1, df_struct.loc[i, "timestamp"], "short", H1_CHOCH_CONFIRM_HOURS)),
                "tier": str(tier_label),                       # 4K: ALPHA_MAX/HIGH/MED/SWEEP_GEM/...
                "tier_mult": float(tier_mult),                 # base × rp × stage4j (sentiment 제외)
                "tier_mult_raw": float(tier_mult_raw),
                "rp_action": str(rp_action),
                "effective_notional_cap": float(effective_notional_cap),
                "tier_pre_total": int(pre_total),
                "tier_sweep_count": int(pre_sweep),
                "tier_fvg_count": int(pre_fvg),
                "tier_ob_count": int(pre_ob),
                "tier_wick_ratio_5": float(wick_r5) if wick_r5 is not None and not pd.isna(wick_r5) else None,
                "risk_pct_base": float(risk_pct),
                "risk_pct_tier_adjusted": float(risk_pct_adjusted),
                # ⭐ Stage 4K 신규 필드 ⭐
                "stage4j_mult":     float(stage4j_mult),
                "stage4j_label":    str(stage4j_label),
                "sentiment_mult":   float(sentiment_mult),
                "sentiment_label":  str(sentiment_label),
                "atoms_dict":       atoms_dict,
            }

        if s["type"] == "long":
            if df_struct.loc[i, "trend"] == "down":
                continue

            h1_confirm = has_recent_h1_choch(
                df_h1_local=df_h1,
                h4_timestamp=df_struct.loc[i, "timestamp"],
                side="long",
                lookback_hours=H1_CHOCH_CONFIRM_HOURS,
            )

            base_entry_candidate = s["zone_low"] + (s["zone_high"] - s["zone_low"]) * LONG_BASE_ENTRY_FRAC

            refined_entry_candidate, improved, refine_px, refine_reason = refine_entry_with_h1_fvg(
                df_h1_local=df_h1,
                h4_timestamp=df_struct.loc[i, "timestamp"],
                side="long",
                zone_low=s["zone_low"],
                zone_high=s["zone_high"],
                base_entry=base_entry_candidate,
                lookback_hours=H1_REFINE_LOOKBACK_HOURS,
                max_improve_frac=H1_REFINE_MAX_IMPROVE_FRAC,
            )

            # [HONEST-FALLBACK] fill_entry_price 결정
            if current_price is not None:
                # 실시간 모드: 현재가 = 체결가 (시장가 주문)
                fill_entry_price = float(current_price)
            else:
                # 백테스트 호환 모드
                fill_entry_price = float(max(s["zone_low"], min(row["open"], s["zone_high"])))
                if row["low"] <= refined_entry_candidate:
                    fill_entry_price = float(refined_entry_candidate)

            raw_sl = s["sweep_ref"] - atr_val * SL_BUFFER_MULT
            sl_candidate = clamp_stop_for_long(fill_entry_price, raw_sl, atr_val)
            if sl_candidate >= fill_entry_price:
                continue

            # ⭐ Stage 4K: evaluate_zones 에서 미리 계산된 값 재사용 ⭐
            pre_sweep = z["tier_pre_sweep"]
            pre_fvg = z["tier_pre_fvg"]
            pre_ob = z["tier_pre_ob"]
            pre_total = z["tier_pre_total"]
            wick_r5 = z["wick_ratio_5"]
            tier_label = z["tier"]
            tier_mult_raw = z["tier_mult_raw"]
            rp_action = z["rp_action"]
            tier_mult = z["tier_mult_final"]
            effective_notional_cap = z["effective_notional_cap"]
            stage4j_mult = z.get("stage4j_mult", 1.0)
            stage4j_label = z.get("stage4j_label", "DEFAULT")
            atoms_dict = z.get("atoms_dict", {})

            # tier 가 passable 이 아니면 위에서 이미 continue 처리됨.

            # ⭐ Stage 4K: Sentiment Momentum lookback (직전 7일 LS 격차) ⭐
            entry_time_now = df_struct.loc[i, "timestamp"]
            sentiment_mult, sentiment_label = get_stage4k_sentiment_mult(
                target_time=entry_time_now,
                side="long",
            )

            # ⭐⭐⭐ Stage 3 Wave-aware 처방 (옵션 A+B+C + Balance-aware) ⭐⭐⭐
            step3_mult, step3_info = get_step3_risk_multipliers(
                df_struct=df_struct, df_h1=df_h1, df_d1=df_d1,
                i=i, side="long", balance=float(balance),
            )

            risk_pct_adjusted = float(risk_pct) * float(tier_mult) * float(sentiment_mult) * float(step3_mult)

            qty_candidate, risk_per_unit, notional_candidate = calc_position_size(
                balance=balance,
                risk_pct=risk_pct_adjusted,
                entry=fill_entry_price,
                sl=sl_candidate,
                fee_rate=fee_rate,
                max_notional_mult=effective_notional_cap,
            )
            if qty_candidate is None:
                continue

            expansion_candidate = get_expansion_state(
                market_state=h4_market_state,
                h1_choch_confirm=h1_confirm,
            )
            plan = get_tp_plan(expansion_candidate)

            return {
                "should_enter": True,
                "timestamp": str(df_struct.loc[i, "timestamp"]),
                "h4_closed_index": int(i),
                "side": "Buy",
                "position_side": "long",
                "entry": float(fill_entry_price),
                "base_entry": float(base_entry_candidate),
                "entry_refined": bool(improved),
                "refined_entry_px": float(refine_px) if pd.notna(refine_px) else None,
                "refine_tag": refine_reason,
                "sl": float(sl_candidate),
                "qty": float(qty_candidate),
                "notional": float(notional_candidate),
                "risk_per_unit": float(risk_per_unit),
                "score": float(eff_score),
                "base_score": float(s["score"]),
                "fresh_reasons": fresh_reasons,
                "grade": grade,
                "run_potential": int(rp),
                "run_tags": rp_tags,
                "tp_plan_name": plan["name"],
                "tp_plan": plan,
                "expansion_state": bool(expansion_candidate),
                "reasons": s["reasons"],
                "zone_low": float(s["zone_low"]),
                "zone_high": float(s["zone_high"]),
                "sweep_ref": float(s["sweep_ref"]),
                "trend": str(df_struct.loc[i, "trend"]),
                "market_state": str(h4_market_state),
                "h1_choch_confirm": bool(h1_confirm),
                "h1_choch_time": str(get_recent_h1_choch_time(df_h1, df_struct.loc[i, "timestamp"], "long", H1_CHOCH_CONFIRM_HOURS)),
                "tier": str(tier_label),
                "tier_mult": float(tier_mult),
                "tier_mult_raw": float(tier_mult_raw),
                "rp_action": str(rp_action),
                "effective_notional_cap": float(effective_notional_cap),
                "tier_pre_total": int(pre_total),
                "tier_sweep_count": int(pre_sweep),
                "tier_fvg_count": int(pre_fvg),
                "tier_ob_count": int(pre_ob),
                "tier_wick_ratio_5": float(wick_r5) if wick_r5 is not None and not pd.isna(wick_r5) else None,
                "risk_pct_base": float(risk_pct),
                "risk_pct_tier_adjusted": float(risk_pct_adjusted),
                # ⭐ Stage 4K 신규 필드 ⭐
                "stage4j_mult":     float(stage4j_mult),
                "stage4j_label":    str(stage4j_label),
                "sentiment_mult":   float(sentiment_mult),
                "sentiment_label":  str(sentiment_label),
                "atoms_dict":       atoms_dict,
            }

    return {
        "should_enter": False,
        "reason": "no_valid_signal_on_latest_closed_h4",
        "timestamp": str(df_struct.loc[i, "timestamp"]),
        "candidate_count": len(evaluated_zones),
        "same_side_cooldown": str(same_side_block) if same_side_block else None,
        "trend": str(df_struct.loc[i, "trend"]),
        "market_state": str(df_struct.loc[i, "market_state"]),
        "latest_close": float(df_struct.loc[i, "close"]),
    }