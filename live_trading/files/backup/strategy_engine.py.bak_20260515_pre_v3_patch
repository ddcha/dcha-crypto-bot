# v1.9b: PRE-ENTRY CONFLUENCE
# =========================================================
def compute_pre_entry_confluence(
    df_h4: pd.DataFrame,
    df_h1: pd.DataFrame,
    h4_entry_idx: int,
    zone_low: float,
    zone_high: float,
    lookback_ltf_bars: int = PRE_ENTRY_LOOKBACK_LTF_BARS,
    exclude_recent_h1: int = 0,
) -> Tuple[int, int, int, int]:
    """
    진입 직전 H1 N개 봉에서 zone 내 FVG/OB/sweep 카운트.
    return: (sweep_count, fvg_count, ob_count, total_count)

    [v1.9_REALISTIC] exclude_recent_h1 파라미터 추가.
    실전에서는 0 (최신 정보 활용), 백테스트에서는 1 (실전 지연 시뮬레이션).
    """
    if h4_entry_idx < 0 or h4_entry_idx >= len(df_h4):
        return 0, 0, 0, 0
    entry_h4_ts = df_h4.iloc[h4_entry_idx]["timestamp"]

    ltf_mask = df_h1["timestamp"] <= entry_h4_ts
    if not ltf_mask.any():
        return 0, 0, 0, 0
    ltf_entry_idx = int(df_h1[ltf_mask].index[-1])

    # v1.9_REALISTIC: 최근 H1 봉 제외
    ltf_entry_idx_adjusted = ltf_entry_idx - int(exclude_recent_h1)
    if ltf_entry_idx_adjusted < 0:
        return 0, 0, 0, 0

    start_idx = max(0, ltf_entry_idx_adjusted - lookback_ltf_bars)
    end_idx = ltf_entry_idx_adjusted
    if start_idx > end_idx or start_idx >= len(df_h1):
        return 0, 0, 0, 0

    sub = df_h1.iloc[start_idx:end_idx + 1]
    fvg_count = ob_count = sweep_count = 0

    for _, r in sub.iterrows():
        # FVG 중심점이 zone 안에 있는지
        for fvg_lo_col, fvg_hi_col in [("bull_fvg_low", "bull_fvg_high"), ("bear_fvg_low", "bear_fvg_high")]:
            lo = r.get(fvg_lo_col)
            hi = r.get(fvg_hi_col)
            if pd.notna(lo) and pd.notna(hi):
                mid = (float(lo) + float(hi)) / 2.0
                if zone_low <= mid <= zone_high:
                    fvg_count += 1

        # OB 중심점이 zone 안에 있는지
        for ob_lo_col, ob_hi_col in [("bull_ob_low", "bull_ob_high"), ("bear_ob_low", "bear_ob_high")]:
            lo = r.get(ob_lo_col)
            hi = r.get(ob_hi_col)
            if pd.notna(lo) and pd.notna(hi):
                mid = (float(lo) + float(hi)) / 2.0
                if zone_low <= mid <= zone_high:
                    ob_count += 1

        # Sweep 플래그 — high/low 가 zone 범위 내에 있을 때만 카운트
        hs = bool(r.get("pivot_sweep_high", False)) or bool(r.get("recent_sweep_high", False))
        ls = bool(r.get("pivot_sweep_low", False)) or bool(r.get("recent_sweep_low", False))
        if hs:
            px = float(r["high"])
            if zone_low <= px <= zone_high:
                sweep_count += 1
        if ls:
            px = float(r["low"])
            if zone_low <= px <= zone_high:
                sweep_count += 1

    total = fvg_count + ob_count + sweep_count
    return sweep_count, fvg_count, ob_count, total


# =========================================================
# v1.9b: WICK RATIO (최근 5봉 방향성 꼬리 비율)
# =========================================================
def compute_wick_ratio_5(
    df_h4: pd.DataFrame,
    df_h1: pd.DataFrame,
    h4_entry_idx: int,
    side: str,
    lookback_n: int = WICK_LOOKBACK_BARS,
    exclude_recent_h1: int = 0,
) -> float:
    """
    진입 직전 H1 N봉의 방향성 꼬리(wick) / 총 range 비율.
    꼬리가 작을수록 강한 진입 확신 (= S 조건).

    side: "long" 이면 아래 꼬리, "short" 이면 위 꼬리 기준.

    [v1.9_REALISTIC] exclude_recent_h1 파라미터 추가.
    """
    if h4_entry_idx < 0 or h4_entry_idx >= len(df_h4):
        return 0.0
    entry_h4_ts = df_h4.iloc[h4_entry_idx]["timestamp"]

    ltf_mask = df_h1["timestamp"] <= entry_h4_ts
    if not ltf_mask.any():
        return 0.0
    ltf_entry_idx = int(df_h1[ltf_mask].index[-1])

    # v1.9_REALISTIC: 최근 H1 봉 제외
    ltf_entry_idx_adjusted = ltf_entry_idx - int(exclude_recent_h1)
    if ltf_entry_idx_adjusted < 0:
        return 0.0

    start_idx = max(0, ltf_entry_idx_adjusted - lookback_n)
    end_idx = ltf_entry_idx_adjusted
    if start_idx >= end_idx:
        return 0.0

    sub = df_h1.iloc[start_idx:end_idx]
    sum_wick = 0.0
    sum_range = 0.0

    for _, r in sub.iterrows():
        try:
            o = float(r["open"])
            c_px = float(r["close"])
            h = float(r["high"])
            l = float(r["low"])
        except Exception:
            continue

        body_top = max(o, c_px)
        body_bot = min(o, c_px)
        bar_range = h - l

        if side == "long":
            directional_wick = body_bot - l
        else:
            directional_wick = h - body_top
        directional_wick = max(0.0, directional_wick)

        sum_wick += directional_wick
        sum_range += bar_range

    if sum_range <= 0:
        return 0.0
    return sum_wick / sum_range


