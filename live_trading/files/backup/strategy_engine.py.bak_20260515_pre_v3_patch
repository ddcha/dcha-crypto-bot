def evaluate_zones_at_current_time(
    df_h4: pd.DataFrame,
    df_h1: pd.DataFrame,
    active_structures: List[Dict[str, Any]],
    i: int,
    exclude_recent_h1: int = 0,
    symbol: Optional[str] = None,
) -> List[Dict[str, Any]]:
    """
    현재 H4 index 기준으로 active zone 들을 일괄 평가 (Stage 4K).
    
    백테스트 4K BOOST15 와 동일 logic:
      1) atomic 12 컨디션 계산 (compute_trade_tags)
      2) Tier 분류 (classify_tier_stage4h)
      3) Tier × side × symbol → risk_mult (4I 차단 포함)
      4) RP boost (RP_MULT_4H, RP0 → 1.5×)
      5) Stage 4J extra mult (1.5×/1.2× booster matrix)
      6) 4J outlier 차단 (GEM_LONG_RP1, ROOM_ONLY_AVAX)
    
    Sentiment mult 는 진입 시점 (generate_entry_signal) 에서 별도 계산.
    
    반환: list of dicts (zone + 평가 결과)
    """
    if i < 0 or i >= len(df_h4):
        return []

    evaluated: List[Dict[str, Any]] = []

    for s in active_structures:
        # Freshness 재평가
        fresh_bonus, fresh_reasons = evaluate_freshness_at_entry(df_h4, s, i)
        eff_score = float(s["score"]) + fresh_bonus
        if eff_score < MIN_SCORE:
            continue

        side_zone = str(s["type"])  # "long" or "short"
        zone_low = float(s["zone_low"])
        zone_high = float(s["zone_high"])
        zone_created_idx = int(s["zone_created_idx"])
        structure_reasons = str(s.get("reasons", ""))

        # Tier 입력값 계산 (exclude_recent_h1 적용)
        pre_sweep, pre_fvg, pre_ob, pre_total = compute_pre_entry_confluence(
            df_h4=df_h4,
            df_h1=df_h1,
            h4_entry_idx=i,
            zone_low=zone_low,
            zone_high=zone_high,
            lookback_ltf_bars=PRE_ENTRY_LOOKBACK_LTF_BARS,
            exclude_recent_h1=exclude_recent_h1,
        )
        wick_r5 = compute_wick_ratio_5(
            df_h4=df_h4,
            df_h1=df_h1,
            h4_entry_idx=i,
            side=side_zone,
            lookback_n=WICK_LOOKBACK_BARS,
            exclude_recent_h1=exclude_recent_h1,
        )

        # ATR (atomic a_room 계산용)
        atr_val = df_h4.loc[i, "atr"] if "atr" in df_h4.columns and pd.notna(df_h4.loc[i, "atr"]) else 0.0

        # ⭐ Stage 4K: atomic 12 컨디션 계산 ⭐
        atoms_dict = compute_trade_tags(
            df_struct=df_h4,
            entry_idx=i,
            zone_created_idx=zone_created_idx,
            zone_low=zone_low,
            zone_high=zone_high,
            side=side_zone,
            pre_total=int(pre_total),
            sweep_count=int(pre_sweep),
            score=float(eff_score),
            wick_ratio_5=float(wick_r5) if wick_r5 is not None else np.nan,
            structure_reasons=structure_reasons,
            atr_val=float(atr_val),
        )

        # ⭐ Stage 4H: Tier 분류 (ALPHA/SWEEP/COMPLETE_OUT/SKIP_MSS) ⭐
        tier_label = classify_tier_stage4h(atoms_dict, side=side_zone)

        # ⭐ Stage 4I 차단 + scenario 적용 ⭐
        tier_mult_raw = get_tier_risk_mult_4h(tier_label, side=side_zone, symbol=symbol)

        # Run Potential
        rp, rp_tags = get_run_potential(df_h4, i, s)

        # ⭐ Stage 4J 차단 (outlier 도박 그룹) ⭐
        stage4j_block = is_stage4j_blocked(tier_label, side_zone, symbol or "", rp)
        if stage4j_block is not None:
            tier_mult_raw = 0.0  # 차단으로 강제

        # RP Boost 필터 (RP_MULT_4H 사용)
        rp_action, tier_mult_after_rp = apply_rp_filter(tier_mult_raw, rp)

        # ⭐ Stage 4J extra mult layer (1.5×/1.2× booster) ⭐
        stage4j_mult, stage4j_label = get_stage4j_extra_mult(
            tier_label, side_zone, symbol or "", rp
        )

        # 최종 tier_mult_final
        tier_mult_final = float(tier_mult_after_rp) * float(stage4j_mult)

        # Notional cap (TIER_CAP_4H 기반)
        effective_cap = resolve_notional_cap(tier_label)

        evaluated.append({
            **s,  # 원본 zone 정보
            "eff_score": float(eff_score),
            "fresh_reasons": fresh_reasons,
            "tier_pre_sweep": int(pre_sweep),
            "tier_pre_fvg": int(pre_fvg),
            "tier_pre_ob": int(pre_ob),
            "tier_pre_total": int(pre_total),
            "wick_ratio_5": float(wick_r5) if wick_r5 is not None else np.nan,
            "atoms_dict": atoms_dict,
            "tier": tier_label,
            "tier_mult_raw": float(tier_mult_raw),
            "run_potential": int(rp),
            "run_tags": rp_tags,
            "rp_action": str(rp_action),
            "stage4j_block": stage4j_block,        # 차단 사유 (None 이면 통과)
            "stage4j_mult": float(stage4j_mult),
            "stage4j_label": stage4j_label,
            "tier_mult_final": float(tier_mult_final),
            "effective_notional_cap": float(effective_cap),
            "tier_passable": tier_mult_final > 0.0,
        })

    return evaluated


def classify_grade(entry_score: float, run_potential: int) -> str:
    if run_potential >= 3 and entry_score >= 10.0:
        return "S"
    if run_potential == 2 and entry_score >= 10.0:
        return "A"
    return "B"


