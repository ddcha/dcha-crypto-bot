# =========================================================
# RP boost filter (백테스트 RP_MULT_4H 사용)
# =========================================================
def apply_rp_filter(tier_mult: float, run_potential: Optional[int]) -> Tuple[str, float]:
    """
    RP boost 적용. 백테스트 RP_MULT_4H 매핑.
    
    RP_MULT_4H = {0: 1.5, 1~5: 1.0}  → RP0 만 1.5× boost, RP6+ 는 SKIP
    """
    if not RP_FILTER_ENABLE:
        return "rp_disabled", float(tier_mult)
    if run_potential is None:
        return "rp_pass", float(tier_mult)
    try:
        rp = int(run_potential)
    except Exception:
        return "rp_pass", float(tier_mult)
    
    if rp not in RP_MULT_4H:
        return f"rp_skip_rp{rp}", 0.0
    
    mult = float(RP_MULT_4H[rp])
    if mult <= 0.0:
        return f"rp_skip_rp{rp}", 0.0
    if mult > 1.0:
        return f"rp_boost_rp{rp}_x{mult}", float(tier_mult) * mult
    if mult < 1.0:
        return f"rp_damp_rp{rp}_x{mult}", float(tier_mult) * mult
    return "rp_pass", float(tier_mult)


