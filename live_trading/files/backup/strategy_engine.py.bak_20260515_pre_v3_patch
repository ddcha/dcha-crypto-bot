# v1.9b: SWEEP FLAGS
# =========================================================
def apply_sweep_flags(df: pd.DataFrame, recent_sweep_n: int = 10) -> pd.DataFrame:
    """
    sweep(유동성 청산) 플래그를 부여:
      - pivot_sweep_high/low: pivot high/low 를 bar 가 뚫었는지
      - recent_sweep_high/low: 최근 N 봉 최고/최저를 뚫었는지
    """
    df = df.copy()
    n = len(df)
    if n == 0:
        df["pivot_sweep_high"] = False
        df["pivot_sweep_low"] = False
        df["recent_sweep_high"] = False
        df["recent_sweep_low"] = False
        return df

    # pivot sweep: pivot_high/low 가 이미 있으면 활용
    if "pivot_high" in df.columns and "pivot_low" in df.columns:
        # 해당 bar 에서 pivot 가격을 뚫었는지
        df["pivot_sweep_high"] = df["high"].shift(0) > df["pivot_high"].ffill()
        df["pivot_sweep_low"] = df["low"].shift(0) < df["pivot_low"].ffill()
    else:
        df["pivot_sweep_high"] = False
        df["pivot_sweep_low"] = False

    # recent N 봉 최고/최저 sweep
    if recent_sweep_n > 0 and n >= recent_sweep_n:
        rolling_high_prev = df["high"].shift(1).rolling(window=recent_sweep_n, min_periods=1).max()
        rolling_low_prev = df["low"].shift(1).rolling(window=recent_sweep_n, min_periods=1).min()
        df["recent_sweep_high"] = df["high"] > rolling_high_prev
        df["recent_sweep_low"] = df["low"] < rolling_low_prev
    else:
        df["recent_sweep_high"] = False
        df["recent_sweep_low"] = False

    df["pivot_sweep_high"] = df["pivot_sweep_high"].fillna(False).astype(bool)
    df["pivot_sweep_low"] = df["pivot_sweep_low"].fillna(False).astype(bool)
    df["recent_sweep_high"] = df["recent_sweep_high"].fillna(False).astype(bool)
    df["recent_sweep_low"] = df["recent_sweep_low"].fillna(False).astype(bool)
    return df


