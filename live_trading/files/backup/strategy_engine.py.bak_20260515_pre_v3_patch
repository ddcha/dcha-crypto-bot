def apply_wave_state(data: pd.DataFrame) -> pd.DataFrame:
    """
    swing sequence 기반 wave_state 분류 (각 timeframe 내부):
      - impulse_up:    HH + HL
      - impulse_down:  LL + LH
      - expansion:     HH + LL  (변동성 확장)
      - compression:   LH + HL  (수렴 — triangle)
      - unclear:       data 부족 또는 동일 가격

    [선결] last_pivot_high, prev_pivot_high, last_pivot_low, prev_pivot_low 가 있어야 함.
    """
    data = data.copy()
    data["wave_state"] = "unclear"
    for i in range(len(data)):
        lph = data.loc[i, "last_pivot_high"]
        pph = data.loc[i, "prev_pivot_high"]
        lpl = data.loc[i, "last_pivot_low"]
        ppl = data.loc[i, "prev_pivot_low"]
        if pd.isna(lph) or pd.isna(pph) or pd.isna(lpl) or pd.isna(ppl):
            continue
        is_HH = lph > pph
        is_LH = lph < pph
        is_HL = lpl > ppl
        is_LL = lpl < ppl
        if is_HH and is_HL:
            data.loc[i, "wave_state"] = "impulse_up"
        elif is_LL and is_LH:
            data.loc[i, "wave_state"] = "impulse_down"
        elif is_HH and is_LL:
            data.loc[i, "wave_state"] = "expansion"
        elif is_LH and is_HL:
            data.loc[i, "wave_state"] = "compression"
    return data


def apply_h1_choch_trend(df_h4: pd.DataFrame, df_h1: pd.DataFrame) -> pd.DataFrame:
    """
    H4 dataframe 의 trend 컬럼을 H1 CHoCH state 기반으로 갈아끼움.
    각 H4 시점 t 에 대해 df_h1 에서 timestamp <= t 인 마지막 bull_choch / bear_choch
    중 더 최근인 쪽이 trend ("up"/"down"/"neutral").
    last_choch_ts, last_choch_dir 컬럼도 추가 (stale CHoCH 모니터링용).
    """
    df_h4 = df_h4.copy()

    if "bull_choch" not in df_h1.columns or "bear_choch" not in df_h1.columns:
        return df_h4

    bull_ts_arr = df_h1.loc[df_h1["bull_choch"], "timestamp"].sort_values().values
    bear_ts_arr = df_h1.loc[df_h1["bear_choch"], "timestamp"].sort_values().values
    n_bull = len(bull_ts_arr)
    n_bear = len(bear_ts_arr)
    h4_ts = df_h4["timestamp"].values
    n_h4 = len(h4_ts)

    if n_bull > 0:
        bull_last_pos = np.searchsorted(bull_ts_arr, h4_ts, side="right") - 1
    else:
        bull_last_pos = np.full(n_h4, -1, dtype=int)
    if n_bear > 0:
        bear_last_pos = np.searchsorted(bear_ts_arr, h4_ts, side="right") - 1
    else:
        bear_last_pos = np.full(n_h4, -1, dtype=int)

    trends = np.array(["neutral"] * n_h4, dtype=object)
    last_choch_ts = np.array([pd.NaT] * n_h4, dtype=object)
    last_choch_dir = np.array(["none"] * n_h4, dtype=object)

    for k in range(n_h4):
        bp = bull_last_pos[k]; rp = bear_last_pos[k]
        has_bull = bp >= 0; has_bear = rp >= 0
        if not has_bull and not has_bear:
            continue
        if has_bull and not has_bear:
            trends[k] = "up"; last_choch_ts[k] = bull_ts_arr[bp]; last_choch_dir[k] = "bull"
            continue
        if has_bear and not has_bull:
            trends[k] = "down"; last_choch_ts[k] = bear_ts_arr[rp]; last_choch_dir[k] = "bear"
            continue
        tb = bull_ts_arr[bp]; tr_ = bear_ts_arr[rp]
        if tb > tr_:
            trends[k] = "up"; last_choch_ts[k] = tb; last_choch_dir[k] = "bull"
        elif tr_ > tb:
            trends[k] = "down"; last_choch_ts[k] = tr_; last_choch_dir[k] = "bear"
        else:
            last_choch_ts[k] = tb; last_choch_dir[k] = "tie"

    df_h4["trend"] = trends
    df_h4["last_choch_ts"] = last_choch_ts
    df_h4["last_choch_dir"] = last_choch_dir
    return df_h4


def build_d1_trend(df_h4: pd.DataFrame) -> pd.DataFrame:
    """H4 봉을 일자별 그룹해서 D1 OHLCV 만든 후 EMA + wave_state 추가."""
    D1_EMA_FAST = 20
    D1_EMA_SLOW = 50

    d = df_h4.copy()
    d["date_utc"] = d["timestamp"].dt.tz_convert("UTC").dt.date
    d1 = d.groupby("date_utc", as_index=False).agg(
        timestamp=("timestamp", "last"),
        open=("open", "first"),
        high=("high", "max"),
        low=("low", "min"),
        close=("close", "last"),
    )
    d1 = d1.sort_values("timestamp").reset_index(drop=True)
    d1["ema_fast"] = d1["close"].ewm(span=D1_EMA_FAST, adjust=False).mean()
    d1["ema_slow"] = d1["close"].ewm(span=D1_EMA_SLOW, adjust=False).mean()
    d1["ema200"]   = d1["close"].ewm(span=200, adjust=False).mean()
    d1["ema200_slope_pct_20d"] = (
        (d1["ema200"] - d1["ema200"].shift(20)) / d1["ema200"].shift(20) * 100.0
    )

    def _ema_state(r):
        if pd.isna(r["ema_slow"]) or pd.isna(r["ema200"]):
            return "neutral"
        if r["ema_slow"] > r["ema200"]:
            return "bull"
        if r["ema_slow"] < r["ema200"]:
            return "bear"
        return "neutral"
    d1["ema_state"] = d1.apply(_ema_state, axis=1)

    def _d1_trend(r):
        if pd.isna(r["ema_fast"]) or pd.isna(r["ema_slow"]):
            return "neutral"
        if r["close"] > r["ema_fast"] > r["ema_slow"]:
            return "up"
        if r["close"] < r["ema_fast"] < r["ema_slow"]:
            return "down"
        return "neutral"
    d1["d1_trend"] = d1.apply(_d1_trend, axis=1)

    # D1 wave_state — swing 분석
    d1 = apply_pivots(d1, swing_len=3)
    d1 = apply_wave_state(d1)
    return d1


def get_wave_pattern_mult(d1ws: str, h4ws: str, h1ws: str, side: str, skip_weak: bool = False) -> float:
    """
    Wave Pattern Rules (옵션 B + 옵션 C). matching된 패턴들의 mult 곱해서 [floor, ceiling] clamp.
    skip_weak=True 면 WEAK 패턴 모두 비활성 (Balance-aware 자본 < 임계 시).
    """
    if not USE_WAVE_PATTERN_RULES:
        return 1.0
    mult = 1.0
    if not skip_weak:
        # WEAK 규칙들
        if ((d1ws == "impulse_up" and h4ws == "impulse_down") or
            (d1ws == "impulse_down" and h4ws == "impulse_up")):
            mult *= PATTERN_MULTS["weak_d1_h4_opposite"]
        if h1ws == "expansion" and side == "short":
            mult *= PATTERN_MULTS["weak_h1_expansion_short"]
        if d1ws == "impulse_up" and h4ws in ("compression", "expansion") and side == "long":
            mult *= PATTERN_MULTS["weak_d1up_h4corr_long"]
        # 옵션 C WEAK: D1=H4 same direction + H1=expansion
        if h1ws == "expansion" and (
            (d1ws == "impulse_up" and h4ws == "impulse_up") or
            (d1ws == "impulse_down" and h4ws == "impulse_down")
        ):
            mult *= PATTERN_MULTS["weak_T2_h1expansion"]
    # STRONG 규칙들 (항상 적용 — boost는 자본 작을 때도 자본 축적 가속에 도움)
    if d1ws == "expansion" and h4ws == "expansion":
        mult *= PATTERN_MULTS["strong_expansion_x_expansion"]
    if h1ws == "compression" and side == "short":
        mult *= PATTERN_MULTS["strong_h1_compression_short"]
    if h1ws == "compression" and side == "long":
        mult *= PATTERN_MULTS["strong_h1_compression_long"]
    # 옵션 C STRONG: D1=H4=impulse_down + H1=compression + SHORT (PF 20!)
    if (d1ws == "impulse_down" and h4ws == "impulse_down" and
        h1ws == "compression" and side == "short"):
        mult *= PATTERN_MULTS["strong_T2aligned_h1comp_short"]
    return max(min(mult, PATTERN_MULT_CEILING), PATTERN_MULT_FLOOR)


def get_step3_risk_multipliers(
    df_struct: pd.DataFrame,
    df_h1: pd.DataFrame,
    df_d1: pd.DataFrame,
    i: int,
    side: str,
    balance: float,
) -> Tuple[float, Dict[str, Any]]:
    """
    Step 3 Wave-aware 처방 통합 risk multiplier 계산.
    Returns (combined_mult, info_dict).
    """
    info = {
        "pd_aware_mult": 1.0,
        "weak_setup_mult": 1.0,
        "wave_pattern_mult": 1.0,
        "d1_wave_state": "unclear",
        "h4_wave_state": "unclear",
        "h1_wave_state": "unclear",
        "entry_pd_loc": "unknown",
        "balance_aware_skip_weak": False,
    }
    # Balance-aware: 자본 작을 때 WEAK 처방 비활성
    skip_weak = bool(USE_BALANCE_AWARE_WEAK_SKIP and balance < WEAK_SKIP_BALANCE_THRESHOLD_USDT)
    info["balance_aware_skip_weak"] = skip_weak

    # H4 row lookup
    try:
        if 0 <= i < len(df_struct):
            h4_row = df_struct.iloc[i]
            info["h4_wave_state"] = str(h4_row.get("wave_state", "unclear"))
            pd_loc = h4_row.get("pd_loc", "unknown")
            info["entry_pd_loc"] = str(pd_loc) if pd.notna(pd_loc) else "unknown"
            # PD-aware (WEAK)
            if USE_PD_AWARE_FILTER and not skip_weak:
                if info["entry_pd_loc"] == "discount" and side == "short":
                    info["pd_aware_mult"] = PD_AWARE_DISCOUNT_SHORT_MULT
    except Exception:
        pass

    # H1 wave_state (timestamp 기반)
    try:
        if df_h1 is not None and len(df_h1) > 0 and "wave_state" in df_h1.columns:
            h4_ts = df_struct.iloc[i]["timestamp"]
            sub = df_h1[df_h1["timestamp"] <= h4_ts]
            if len(sub) > 0:
                info["h1_wave_state"] = str(sub.iloc[-1].get("wave_state", "unclear"))
    except Exception:
        pass

    # D1 wave_state
    try:
        if df_d1 is not None and len(df_d1) > 0 and "wave_state" in df_d1.columns:
            h4_ts = df_struct.iloc[i]["timestamp"]
            sub = df_d1[df_d1["timestamp"] < h4_ts]
            if len(sub) > 0:
                info["d1_wave_state"] = str(sub.iloc[-1].get("wave_state", "unclear"))
    except Exception:
        pass

    # 옵션 A: Weak Setup Blacklist (WEAK)
    if USE_WEAK_SETUP_FILTER and not skip_weak:
        setup_key = (info["d1_wave_state"], info["h4_wave_state"], info["h1_wave_state"], side)
        if setup_key in WEAK_SETUPS_SET:
            info["weak_setup_mult"] = WEAK_SETUP_RISK_MULT

    # 옵션 B/C: Wave Pattern Rules
    info["wave_pattern_mult"] = get_wave_pattern_mult(
        info["d1_wave_state"], info["h4_wave_state"], info["h1_wave_state"], side,
        skip_weak=skip_weak,
    )

    # Combined mult (PATTERN_MULT_FLOOR로 너무 작아지지 않게 보호)
    combined = info["pd_aware_mult"] * info["weak_setup_mult"] * info["wave_pattern_mult"]
    combined = max(combined, PATTERN_MULT_FLOOR)
    return combined, info


